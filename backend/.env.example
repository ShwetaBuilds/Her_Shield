PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_URL=http://localhost:5173,http://localhost:4173
NODE_ENV=development
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
# Server-side Maps key only if a backend feature explicitly needs one; never use this in VITE_* variables.
GOOGLE_MAPS_API_KEY=your_server_side_google_maps_key
# Twilio SMS configuration (backend/.env only; never use VITE_ variables for credentials).
# Required for SOS SMS: Account SID and Auth Token from the Twilio Console, plus either:
# 1) a Messaging Service SID containing an SMS-capable sender, or
# 2) a Twilio sender number in E.164 format, such as +12025550123.
# Select a Twilio sender/service that is authorized for your recipient countries.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
# Use TWILIO_FROM instead when a Messaging Service SID is not used.
# TWILIO_FROM=your_twilio_sender_number
# Optional public HTTPS callback URL for Twilio delivery status updates. Twilio must be able to
# reach this URL; provider acceptance is not delivery confirmation. Delivery is confirmed only
# when the signed callback reports "delivered".
# TWILIO_STATUS_CALLBACK_URL=https://your-public-api.example.com/api/notifications/twilio-status
#
# Copy this file to backend/.env, replace the Twilio placeholders with values from the Twilio
# Console, and restart the backend. Do not commit backend/.env or expose credentials in frontend
# environment variables. The application does not send a test message during startup.
